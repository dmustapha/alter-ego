# Alter Ego — Environment Configuration (example)
# Copy to .env.local and fill in real values

# === OKX API Credentials ===
# Apply at: https://web3.okx.com/onchain-os/dev-portal
OKX_API_KEY=your-okx-api-key-here
OKX_SECRET_KEY=your-okx-secret-key-here
OKX_PASSPHRASE=your-okx-passphrase-here

# === x402 Payment Config ===
X402_PAYTO_ADDRESS=0xYourPayToAddressHere
X402_PRICE=0.001
# X402_PAYER_KEY — LOCAL-ONLY funds key, never deployed; store only in .env.local

# === A2MCP (Agent-to-MCP) Config ===
A2MCP_ENDPOINT_URL=https://your-a2mcp-endpoint-here
A2MCP_PAYTO_ADDRESS=0xYourA2MCPPayToAddressHere

# === LLM / Groq Config ===
GROQ_API_KEY=your-groq-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# === Chain Config ===
XLAYER_RPC=https://your-xlayer-rpc-here

# === App Config ===
# Demo mode (default: auto-detected from cache files)
DEMO_MODE=true
